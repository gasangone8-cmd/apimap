# 모두 선택 설정입니다. 환경변수 없이도 검색됩니다.
# Redis 사용 시 같은 데이터베이스를 모든 배포에서 공유하세요.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 미설정 시 Vercel 배포 도메인으로 앱 식별자를 자동 생성합니다.
NOMINATIM_USER_AGENT=ApiMap/1.0 (https://your-project.vercel.app)
# 자체 호스팅 또는 호환 제공자로 변경 가능 (search 엔드포인트)
NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
